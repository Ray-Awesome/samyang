{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "samyang",
  // 미디어브레인 Cloudflare 계정. 다른 계정으로 잘못 배포하지 않도록 고정한다.
  "account_id": "b50df4bb0b0ca01535bf20b2dc621489",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "samyang-poll-db",
      // database_id를 비워 두면 첫 배포 때 Wrangler가 데이터베이스를 만들고 연결한다.
      "migrations_dir": "migrations"
    }
  ],
  // 세 호 메일 화면(/mail). scripts/build-mail.mjs가 design/ 시안으로 만든다. 같은 이름의 파일이 있으면 Worker보다 먼저 응답한다.
  "assets": { "directory": "./public", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "observability": { "enabled": true },
  // main 외 브랜치(PR) 빌드는 `wrangler preview`로 미리보기를 올린다. 이 블록이 있어야 그 명령이 돈다. 비워 두면 위 설정을 그대로 쓴다.
  "previews": {}
}
